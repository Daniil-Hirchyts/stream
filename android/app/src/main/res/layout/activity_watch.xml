<!-- Keep focus after pointer input so Android delivers the very first D-pad seek to the player. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/player_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000"
    android:focusable="true" android:focusableInTouchMode="true">
    <include layout="@layout/playback_video" />
    <include layout="@layout/playback_layers" />
    <include layout="@layout/playback_menu" />
    <!-- Outside fading player layers and menus: one fixed clock, as on browse screens. -->
    <TextClock android:id="@+id/player_clock" style="@style/Text.Time"
        android:layout_width="wrap_content" android:layout_height="40dp"
        android:layout_gravity="top|right" android:layout_marginTop="22dp" android:layout_marginRight="48dp"
        android:gravity="center_vertical" android:importantForAccessibility="no"
        android:textColor="@color/tv_text" android:textSize="16sp" android:elevation="32dp" android:visibility="gone" />
</FrameLayout>
