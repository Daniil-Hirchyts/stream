<?xml version="1.0" encoding="utf-8"?>
<!-- Stream's override of the shared player's layers (same IDs and view types; see android/playback). Layers, bottom to
     top: preparing state, buffering, playback overlay, subtitles, up next, error. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Preparing: opening, or another step the app names, until the first frame is ready. Not an error. -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/idle_inset"
        android:paddingEnd="@dimen/idle_inset"
        android:visibility="gone">

        <TextView
            android:id="@+id/loading_title"
            style="@style/TvLoadingTitle"
            android:layout_width="560dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2" />

        <!-- The shared player may update these labels at every stage. Their parent gates them
             together, so transport details cannot flash into the normal viewing experience. -->
        <LinearLayout
            android:id="@+id/loading_diagnostics"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/loading_step" style="@style/Text.Overline" android:gravity="center" />
            <TextView
                android:id="@+id/loading_message"
                style="@style/Text.Body"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            style="@style/Spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        style="@style/Spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Playback overlay, after tvOS: the text title with watched, tracks and settings actions
         beside it, and the timeline at the bottom. Every control works by remote, pointer
         and touch. -->
    <!-- Not clipping, so a focused button's growth is drawn whole. -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:id="@+id/player_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/safe_horizontal"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="@dimen/safe_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The shared exit action becomes a minimal Back button beside the title. -->
            <ImageView
                android:id="@+id/control_stop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:layout_gravity="top"
                android:background="@drawable/tv_utility_button"
                android:contentDescription="@string/hint_back"
                android:defaultFocusHighlightEnabled="false"
                android:padding="10dp"
                android:rotation="180"
                android:src="@drawable/ic_tv_chevron"
                android:tint="@color/tv_on_glass_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/controls_title"
                    style="@style/TvPlayerTitle"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/watching_info"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="@color/tv_text_on_artwork"
                    android:visibility="gone" />

                <!-- Keep the shared track-summary binding inside a hidden, non-layout parent. -->
                <FrameLayout android:layout_width="0dp" android:layout_height="0dp"
                    android:importantForAccessibility="noHideDescendants" android:visibility="gone">
                    <TextView android:id="@+id/controls_details" style="@style/Text.Caption" />
                </FrameLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/control_watched"
                android:layout_gravity="top"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/tv_button_round"
                android:contentDescription="Mark watched"
                android:padding="10dp"
                android:src="@drawable/ic_tv_check"
                android:tint="@color/tv_on_glass" />

            <ImageView
                android:id="@+id/control_options"
                android:layout_gravity="top"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/tv_button_round"
                android:contentDescription="@string/player_audio_subtitles"
                android:padding="10dp"
                android:src="@drawable/ic_tv_subtitles"
                android:tint="@color/tv_on_glass" />

            <!-- Quality, speed and subtitle style; the button beside it holds the audio and subtitle choices. -->
            <ImageView
                android:id="@+id/control_settings"
                android:layout_gravity="top"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/tv_button_round"
                android:contentDescription="@string/player_settings"
                android:padding="10dp"
                android:src="@drawable/ic_tv_settings"
                android:tint="@color/tv_on_glass" />

        </LinearLayout>

        <!-- Retain the shared binding without a visible or focusable centre control. -->
        <ImageView
            android:id="@+id/center_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Tap the timeline to pause/resume; drag to seek. Time and feedback follow the playhead,
             bounded before the end-time label. Hidden transport views retain the shared bindings. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/safe_horizontal"
            android:layout_marginEnd="@dimen/safe_horizontal"
            android:layout_marginBottom="22dp"
            android:orientation="vertical">

            <tv.stream.app.ui.PlayerTimeline
                android:id="@+id/progress"
                style="@android:style/Widget.Material.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/control_seek"
                android:max="1000"
                android:background="@null"
                android:defaultFocusHighlightEnabled="false"
                android:maxHeight="2dp"
                android:minHeight="2dp"
                android:progressDrawable="@drawable/tv_timeline_track"
                android:splitTrack="false"
                android:thumb="@drawable/tv_timeline_thumb"
                android:thumbOffset="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:thumbTint="@color/tv_focus" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:minHeight="24dp">

                <!-- Time is the anchor; feedback changes without moving it. At the right edge the
                     feedback moves before the time, keeping the readout clear of the remaining time. -->
                <LinearLayout
                    android:id="@+id/timeline_info"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/elapsed"
                        style="@style/TvTimelineTime"
                        android:textColor="@color/tv_text" />

                    <FrameLayout
                        android:id="@+id/timeline_status"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp">

                        <ImageView
                            android:id="@+id/timeline_paused"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/tv_timeline_pause_ring"
                            android:contentDescription="Paused"
                            android:padding="3dp"
                            android:src="@drawable/ic_pause"
                            android:tint="@color/tv_text_on_artwork"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/seek_bubble"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:accessibilityLiveRegion="polite"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/seek_icon"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:importantForAccessibility="no"
                                android:tint="@color/tv_text_on_artwork" />

                            <TextView
                                android:id="@+id/seek_label"
                                style="@style/TvTimelineTime"
                                android:layout_marginStart="3dp"
                                android:textSize="12sp"
                                android:textColor="@color/tv_text_on_artwork" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/remaining"
                    style="@style/TvTimelineTime"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center_vertical"
                    android:textColor="@color/tv_text_on_artwork" />

                <ImageView
                    android:id="@+id/control_rewind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/control_rewind"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/control_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/control_forward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/control_forward"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Subtitles sit above the overlay's scrim so it never dims them. Between cues, this view also shows a
         sample line while subtitle style changes. -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- A manual shortcut before the ending. The existing autoplay countdown begins only after playback ends. -->
    <LinearLayout
        android:id="@+id/next_episode_offer"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:layout_marginBottom="94dp"
        android:background="@drawable/tv_dialog"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">
        <TextView android:id="@+id/next_episode_context" style="@style/Text.Caption"
            android:textSize="12sp" />
        <TextView android:id="@+id/next_episode_name" style="@style/Text.Label"
            android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center_vertical">
            <TextView android:id="@+id/next_episode_play" style="@style/Action"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                android:background="@drawable/tv_button" android:gravity="center"
                android:text="Next episode" android:contentDescription="Next episode" />
            <ImageView android:id="@+id/next_episode_dismiss" android:layout_width="34dp"
                android:layout_height="34dp" android:layout_marginStart="8dp"
                android:background="@drawable/tv_button_round" android:padding="9dp"
                android:src="@drawable/ic_tv_close" android:tint="@color/tv_on_glass"
                android:focusable="true" android:contentDescription="Dismiss next episode" />
        </LinearLayout>
    </LinearLayout>

    <!-- Up next: shown when an episode ends and the series has another. -->
    <LinearLayout
        android:id="@+id/up_next"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:background="@drawable/bg_card_soft"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            style="@style/Text.Overline"
            android:text="@string/up_next" />

        <TextView
            android:id="@+id/up_next_title"
            style="@style/Text.Title"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/up_next_detail"
            style="@style/Text.Caption"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/up_next_play" style="@style/Action" android:background="@drawable/tv_button" android:text="@string/hint_play_now" />
            <TextView android:id="@+id/up_next_cancel" style="@style/Action" android:background="@drawable/tv_button" android:text="@string/hint_cancel" />
        </LinearLayout>
    </LinearLayout>

    <!-- An unprompted playback failure uses the same compact menu surface. Back/Left exits; no extra Close action. -->
    <FrameLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/error_surface"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tv_dialog"
            android:elevation="12dp"
            android:clickable="true"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/error_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:gravity="start"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/error_retry"
                style="@style/TvPlayerAlertButton"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic_tv_refresh"
                android:text="@string/hint_retry" />

            <!-- Shown only when the app can offer another source. -->
            <TextView
                android:id="@+id/error_sources"
                style="@style/TvPlayerAlertButton"
                android:drawableStart="@drawable/ic_tv_list"
                android:text="@string/hint_sources"
                android:visibility="gone" />

            <!-- Binding retained for the shared player; this app exits with Back/Left or a press outside. -->
            <TextView android:id="@+id/error_close" style="@style/TvPlayerAlertButton" android:visibility="gone" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/error_diagnostics"
            android:clickable="true"
            android:layout_width="332dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</merge>
