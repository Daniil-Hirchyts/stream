<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen artwork, a page-owned viewport and a morphing navigation popup. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@drawable/tv_canvas">
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_canvas">
        <ImageView
            android:id="@+id/backdrop_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <!-- The same artwork, blurred and fading in towards the bottom, where text, buttons and shelves sit. -->
        <ImageView
            android:id="@+id/backdrop_soft"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <View
            android:id="@+id/backdrop_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/tv_scrim" />
    </eightbitlab.com.blurview.BlurTarget>
    <!-- The page spans the screen: its rail inset is the page gutter, and scrolled shelves fade out under the rail. -->
    <tv.stream.app.ui.PageViewport android:id="@+id/browse_content"
        android:layout_width="match_parent" android:layout_height="match_parent" android:clipChildren="true">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/page_rows" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipChildren="false" android:clipToPadding="false"
            android:paddingTop="76dp" android:paddingBottom="32dp" android:scrollbars="none" />
        <View android:id="@+id/scroll_fade" android:layout_width="match_parent" android:layout_height="72dp"
            android:alpha="0" android:background="@drawable/tv_scroll_fade" android:importantForAccessibility="no" />
    </tv.stream.app.ui.PageViewport>
    <!-- Pointer/touch entry when the rail is hidden. Back remains above this transparent edge target. -->
    <View android:id="@+id/navigation_reveal" android:layout_width="32dp" android:layout_height="match_parent"
        android:contentDescription="Open navigation" android:visibility="gone" />
    <!-- Back and Refresh remain circular icon-only controls, independent of the rail's width. -->
    <FrameLayout android:id="@+id/page_back" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="40dp" android:layout_marginTop="24dp"
        android:background="@drawable/tv_utility_button" android:contentDescription="Back" android:visibility="gone">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
            android:rotation="180" android:src="@drawable/ic_tv_chevron" android:tint="@color/tv_on_glass_secondary"
            android:duplicateParentState="true" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/browse_toolbar" android:layout_width="wrap_content" android:layout_height="40dp"
        android:layout_gravity="top|end" android:layout_marginTop="24dp" android:layout_marginEnd="40dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
        <FrameLayout android:id="@+id/home_tools" android:layout_width="40dp" android:layout_height="40dp"
            android:clipChildren="false" android:visibility="gone">
            <FrameLayout android:id="@+id/home_refresh" android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/tv_utility_button" android:contentDescription="Refresh">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
                    android:src="@drawable/ic_tv_refresh" android:tint="@color/tv_on_glass_secondary"
                    android:duplicateParentState="true" android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>
        <TextClock android:id="@+id/clock" style="@style/Text.Time"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp"
            android:singleLine="true" android:importantForAccessibility="no" android:visibility="gone"
            android:shadowColor="#B3000000" android:shadowDy="1" android:shadowRadius="6"
            android:textColor="@color/tv_text_secondary" />
    </LinearLayout>
    <!-- Like contextual menus, an outside click dismisses navigation without activating the page beneath it. -->
    <View android:id="@+id/navigation_dismiss" android:layout_width="match_parent" android:layout_height="match_parent"
        android:contentDescription="Close navigation" android:visibility="gone" />
    <tv.stream.app.ui.NavigationRail android:id="@+id/top_bar"
        android:layout_width="56dp" android:layout_height="match_parent"
        android:layout_marginStart="32dp" android:layout_marginTop="24dp" android:layout_marginBottom="24dp"
        android:clipChildren="false" android:clipToPadding="false">
        <tv.stream.app.ui.GlassView android:id="@+id/top_bar_controls"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center_vertical" android:background="@drawable/tv_rail"
            android:padding="6dp" android:elevation="6dp" android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:id="@+id/tab_cluster"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
                <FrameLayout android:id="@+id/search_button" android:layout_width="match_parent" android:layout_height="44dp"
                    android:background="@drawable/tv_tab" android:contentDescription="Search" />
                <LinearLayout android:id="@+id/navigation"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" />
            </LinearLayout>
        </tv.stream.app.ui.GlassView>
    </tv.stream.app.ui.NavigationRail>
</FrameLayout>
