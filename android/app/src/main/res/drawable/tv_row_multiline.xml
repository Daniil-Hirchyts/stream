<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS list rows have no background until focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_focus" /><corners android:radius="14dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_focus_pressed" /><corners android:radius="14dp" /></shape></item>
    <item android:state_activated="true"><shape><solid android:color="@color/tv_platter_low" /><corners android:radius="14dp" /></shape></item>
    <item><shape><solid android:color="#00000000" /><corners android:radius="14dp" /></shape></item>
</selector>
