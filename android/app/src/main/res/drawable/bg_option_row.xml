<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the shared player's menu row: white platter for the focused row, plain otherwise, like Stream's lists. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/tv_focus" />
            <corners android:radius="@dimen/tv_radius_capsule" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/tv_radius_capsule" />
        </shape>
    </item>
</selector>
