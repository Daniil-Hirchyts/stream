<?xml version="1.0" encoding="utf-8"?>
<!-- The selected chip is a near-white platter, so the current filter reads at a glance without focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_focus" /><corners android:radius="@dimen/tv_radius_capsule" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_focus_pressed" /><corners android:radius="@dimen/tv_radius_capsule" /></shape></item>
    <item android:state_activated="true"><shape><solid android:color="@color/tv_chip_selected" /><corners android:radius="@dimen/tv_radius_capsule" /></shape></item>
    <item><shape><solid android:color="@color/tv_platter" /><corners android:radius="@dimen/tv_radius_capsule" /></shape></item>
</selector>
