<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_focus" /><corners android:radius="24dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_focus_pressed" /><corners android:radius="24dp" /></shape></item>
    <item><shape><solid android:color="#12FFFFFF" /><stroke android:width="1dp" android:color="@color/tv_hairline" /><corners android:radius="24dp" /></shape></item>
