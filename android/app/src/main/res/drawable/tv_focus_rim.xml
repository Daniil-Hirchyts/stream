<?xml version="1.0" encoding="utf-8"?>
<!-- A white rim on focused artwork, so the selected poster reads at a glance even when its art is dark. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/tv_radius_control" />
            <stroke android:width="3dp" android:color="#F2FFFFFF" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
