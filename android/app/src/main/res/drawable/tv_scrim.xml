<!-- Keeps title text readable over artwork: darker towards the text and at the bottom. The softened
     backdrop layer blurs the same areas, so the scrim can stay light and the artwork airy. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><gradient android:angle="0" android:startColor="#D90A0A0D" android:centerX="0.55" android:centerColor="#6B0A0A0D" android:endColor="#000A0A0D" /></shape></item>
    <item><shape><gradient android:angle="90" android:startColor="#F00A0A0D" android:centerY="0.32" android:centerColor="#730A0A0D" android:endColor="#000A0A0D" /></shape></item>
</layer-list>
