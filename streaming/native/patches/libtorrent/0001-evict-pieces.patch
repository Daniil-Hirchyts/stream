+	// Daniil TV patch: see torrent_handle::evict_pieces(). The storage keeps
+	// only a window of the torrent, so a piece it discards must look as if it
+	// was never downloaded: to the piece picker, to file progress, to the
+	// finished and seeding states, and to peers.
+	void torrent::evict_pieces(std::vector<piece_index_t> const& pieces
+		, std::function<void(std::vector<piece_index_t>)> const& done)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		std::vector<piece_index_t> evicted;
+		if (!m_abort && valid_metadata() && m_connections_initialized
+			&& m_state != torrent_status::checking_files
+			&& m_state != torrent_status::checking_resume_data)
+		{
+			// a seed has every piece, even without a piece picker
+			bool const seed_without_picker = !has_picker() && is_seed();
+			for (piece_index_t const p : pieces)
+			{
+				if (p < piece_index_t(0) || p >= m_torrent_file->end_piece()) continue;
+				if (seed_without_picker || (has_picker() && m_picker->have_piece(p)))
+					evicted.push_back(p);
+			}
+			std::sort(evicted.begin(), evicted.end());
+			evicted.erase(std::unique(evicted.begin(), evicted.end()), evicted.end());
+		}
+		if (!evicted.empty()) evict_pieces_impl(evicted);
+		if (done) done(std::move(evicted));
+	}
+
+	void torrent::evict_pieces_impl(std::vector<piece_index_t> const& evicted)
+	{
+		INVARIANT_CHECK;
+
+		bool const was_finished = is_finished();
+		bool const was_seed = is_seed();
+
+		if (!has_picker())
+		{
+			// a seed drops its piece picker. Rebuild it the way resume data
+			// does, with every piece already on disk. we_have_all() is not
+			// used, since it leaves pad bytes unaccounted for
+			set_have_all(false);
+			need_picker();
+			for (piece_index_t const i : m_torrent_file->piece_range())
+				m_picker->piece_flushed(i);
+		}
+
+		for (piece_index_t const p : evicted)
+			m_picker->we_dont_have(p);
+
+		// file progress has no way to remove a piece; rebuild it from the picker
+		m_file_progress.clear();
+		m_file_progress.init(*m_picker, m_torrent_file->layout());
+
+		// queued uploads of these pieces can no longer be served. Every peer
+		// that understands lt_donthave is told, seeds too: a seed that thinks
+		// we have every piece drops us as redundant. A downloading peer without
+		// it is reconnected, so it gets a new bitfield instead of requesting
+		// pieces we lost. Seeds and upload-only peers never request, so they may
+		// keep a stale view
+		std::vector<std::shared_ptr<peer_connection>> stale;
+		for (auto* const c : m_connections)
+		{
+			TORRENT_INCREMENT(m_iterating_connections);
+			if (c->is_disconnecting()) continue;
+			for (piece_index_t const p : evicted) c->reject_piece(p);
+			if (c->type() != connection_type::bittorrent || c->is_connecting()) continue;
+			auto* const bt = static_cast<bt_peer_connection*>(c);
+			if (bt->supports_dont_have())
+			{
+				for (piece_index_t const p : evicted) bt->write_dont_have(p);
+			}
+			else if (!c->is_seed() && !c->upload_only())
+			{
+				stale.push_back(c->self());
+			}
+		}
+		for (auto const& c : stale)
+			c->disconnect(errors::pieces_evicted, operation_t::bittorrent
+				, peer_connection_interface::normal);
+
+		// is_seed() follows the seeding state until it changes, so a former
+		// seed leaves it before its interest in peers is re-evaluated
+		if (m_state == torrent_status::seeding)
+			set_state(torrent_status::finished);
+
+		update_gauge();
+		update_state_timers();
+		// resumes downloading if an evicted piece is still wanted
+		update_peer_interest(was_finished);
+
+		// Seeds and upload-only peers were dropped while this torrent was a seed,
+		// as redundant. Now that it downloads again they may be reconnected at
+		// once, rather than after the usual reconnect delay
+		if (was_seed && m_peer_list && !is_finished())
+		{
+			for (auto* const p : *m_peer_list)
+			{
+				if (p->connection == nullptr && (p->seed || p->upload_only))
+					p->last_connected = 0;
+			}
+		}
+		update_want_peers();
+		update_want_tick();
+		update_state_list();
+		set_need_save_resume(torrent_handle::if_download_progress);
+		state_updated();
+	}
+
 	// this is called when the piece hash is checked as correct. Note
 	// that the piece picker and the torrent won't necessarily consider
 	// us to have this piece yet, since it might not have been flushed
