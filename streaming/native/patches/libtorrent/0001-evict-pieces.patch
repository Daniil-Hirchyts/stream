diff --git a/src/torrent.cpp b/src/torrent.cpp
index 70ab02c..c581dc0 100644
--- a/src/torrent.cpp
+++ b/src/torrent.cpp
@@ -4863,6 +4863,114 @@ namespace {
 		return ret;
