<?xml version="1.0" encoding="utf-8"?>
<!-- A chip's label: dark on the white focused or selected chip, white at rest. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/tv_on_focus" />
    <item android:state_pressed="true" android:color="@color/tv_on_focus" />
    <item android:state_activated="true" android:color="@color/tv_on_focus" />
    <item android:color="@color/tv_text" />
</selector>
