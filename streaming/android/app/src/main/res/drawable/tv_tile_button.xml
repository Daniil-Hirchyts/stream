<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_glass_focus_fill" /><corners android:radius="24dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_glass_pressed" /><corners android:radius="24dp" /></shape></item>
    <item android:state_activated="true"><shape><solid android:color="@color/tv_glass_selected" /><corners android:radius="24dp" /></shape></item>
    <item><shape><solid android:color="@color/tv_glass_low" /><stroke android:width="1dp" android:color="@color/tv_hairline" /><corners android:radius="24dp" /></shape></item>
</selector>
