<?xml version="1.0" encoding="utf-8"?>
<!-- An activity indicator after Apple's: eight rounded spokes with a fading tail, turning clockwise at a constant speed.
     An animated vector runs on the render thread, so it keeps turning while the main thread lays out a page or
     opens a source (an animated-rotate is driven by the main thread and stalls with it). Tinted by its user. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">
            <group android:name="wheel" android:pivotX="24" android:pivotY="24">
            <group android:rotation="0" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M24,5 L24,13" android:strokeColor="#FFFFFFFF" android:strokeAlpha="1.0"
                    android:strokeLineCap="round" android:strokeWidth="4.2" />
            </group>
            <group android:rotation="45" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M24,5 L24,13" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.28"
                    android:strokeLineCap="round" android:strokeWidth="4.2" />
            </group>
            <group android:rotation="90" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M24,5 L24,13" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.32"
                    android:strokeLineCap="round" android:strokeWidth="4.2" />
            </group>
            <group android:rotation="135" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M24,5 L24,13" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.38"
                    android:strokeLineCap="round" android:strokeWidth="4.2" />
            </group>
            <group android:rotation="180" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M24,5 L24,13" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.46"
                    android:strokeLineCap="round" android:strokeWidth="4.2" />
            </group>
            <group android:rotation="225" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M24,5 L24,13" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.57"
                    android:strokeLineCap="round" android:strokeWidth="4.2" />
            </group>
            <group android:rotation="270" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M24,5 L24,13" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.7"
                    android:strokeLineCap="round" android:strokeWidth="4.2" />
            </group>
            <group android:rotation="315" android:pivotX="24" android:pivotY="24">
                <path android:pathData="M24,5 L24,13" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0.85"
                    android:strokeLineCap="round" android:strokeWidth="4.2" />
            </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="wheel">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1000" android:repeatCount="infinite" android:propertyName="rotation"
                android:valueFrom="0" android:valueTo="360" android:valueType="floatType"
                android:interpolator="@android:anim/linear_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
