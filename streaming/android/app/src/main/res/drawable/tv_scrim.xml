<!-- Keeps text readable over any artwork: dark to the left, at the bottom and under the tab bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><gradient android:angle="0" android:startColor="#F20A0A0D" android:centerX="0.55" android:centerColor="#800A0A0D" android:endColor="#100A0A0D" /></shape></item>
    <item><shape><gradient android:angle="90" android:startColor="#FF0A0A0D" android:centerY="0.35" android:centerColor="#990A0A0D" android:endColor="#000A0A0D" /></shape></item>
    <item android:gravity="top" android:height="120dp"><shape><gradient android:angle="270" android:startColor="#B30A0A0D" android:endColor="#000A0A0D" /></shape></item>
</layer-list>
