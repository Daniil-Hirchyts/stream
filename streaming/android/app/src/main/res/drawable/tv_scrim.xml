<!-- Keeps text readable over any artwork: darker to the left, at the bottom and under the tab bar. The softened
     backdrop layer blurs the same areas, so the scrim can stay light and the artwork airy. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><gradient android:angle="0" android:startColor="#C70A0A0D" android:centerX="0.5" android:centerColor="#500A0A0D" android:endColor="#000A0A0D" /></shape></item>
    <item><shape><gradient android:angle="90" android:startColor="#F00A0A0D" android:centerY="0.32" android:centerColor="#730A0A0D" android:endColor="#000A0A0D" /></shape></item>
    <item android:gravity="top" android:height="110dp"><shape><gradient android:angle="270" android:startColor="#8C0A0A0D" android:endColor="#000A0A0D" /></shape></item>
</layer-list>
