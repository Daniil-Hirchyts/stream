<?xml version="1.0" encoding="utf-8"?>
<!-- Alert buttons: equal platters, white when focused, as on tvOS. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_focus" /><corners android:radius="12dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_focus_pressed" /><corners android:radius="12dp" /></shape></item>
    <item><shape><solid android:color="@color/tv_platter" /><corners android:radius="12dp" /></shape></item>
</selector>
