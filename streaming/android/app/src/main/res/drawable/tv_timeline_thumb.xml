<?xml version="1.0" encoding="utf-8"?>
<!-- A fixed drawable canvas keeps the playhead centred as focus grows its small capsule. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><inset android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="2dp" android:insetBottom="2dp"><shape><size android:width="4dp" android:height="14dp" /><solid android:color="@color/tv_focus" /><corners android:radius="2dp" /></shape></inset></item>
    <item android:state_focused="true"><inset android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="2dp" android:insetBottom="2dp"><shape><size android:width="4dp" android:height="14dp" /><solid android:color="@color/tv_focus" /><corners android:radius="2dp" /></shape></inset></item>
    <item android:state_hovered="true"><inset android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="2dp" android:insetBottom="2dp"><shape><size android:width="4dp" android:height="14dp" /><solid android:color="@color/tv_focus" /><corners android:radius="2dp" /></shape></inset></item>
    <item><inset android:insetLeft="3dp" android:insetRight="3dp" android:insetTop="4dp" android:insetBottom="4dp"><shape><size android:width="2dp" android:height="10dp" /><solid android:color="@color/tv_focus" /><corners android:radius="1dp" /></shape></inset></item>
</selector>
