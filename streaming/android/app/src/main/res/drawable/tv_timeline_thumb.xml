<?xml version="1.0" encoding="utf-8"?>
<!-- A fixed drawable canvas keeps the playhead centred as focus grows its small capsule. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><inset android:insetLeft="1dp" android:insetRight="1dp" android:insetTop="1dp" android:insetBottom="1dp"><shape><size android:width="6dp" android:height="16dp" /><solid android:color="@color/tv_focus" /><corners android:radius="3dp" /></shape></inset></item>
    <item android:state_focused="true"><inset android:insetLeft="1dp" android:insetRight="1dp" android:insetTop="1dp" android:insetBottom="1dp"><shape><size android:width="6dp" android:height="16dp" /><solid android:color="@color/tv_focus" /><corners android:radius="3dp" /></shape></inset></item>
    <item android:state_hovered="true"><inset android:insetLeft="1dp" android:insetRight="1dp" android:insetTop="1dp" android:insetBottom="1dp"><shape><size android:width="6dp" android:height="16dp" /><solid android:color="@color/tv_focus" /><corners android:radius="3dp" /></shape></inset></item>
    <item><inset android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="3dp" android:insetBottom="3dp"><shape><size android:width="4dp" android:height="12dp" /><solid android:color="@color/tv_focus" /><corners android:radius="2dp" /></shape></inset></item>
</selector>
