<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the shared player's outlined keycaps with this app's borderless glass. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_glass_focus_fill" /><corners android:radius="22dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_glass_pressed" /><corners android:radius="22dp" /></shape></item>
    <item><shape><solid android:color="@color/tv_glass_low" /><corners android:radius="22dp" /></shape></item>
</selector>
