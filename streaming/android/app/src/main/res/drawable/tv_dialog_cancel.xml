<?xml version="1.0" encoding="utf-8"?>
<!-- An alert's Cancel or Close: no platter, only a hairline outline, so it reads apart from the choices above it.
     White when focused, like every alert button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/tv_focus" /><corners android:radius="@dimen/tv_radius_control" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/tv_focus_pressed" /><corners android:radius="@dimen/tv_radius_control" /></shape></item>
    <item><shape><solid android:color="@android:color/transparent" /><stroke android:width="1dp" android:color="@color/tv_hairline" /><corners android:radius="@dimen/tv_radius_control" /></shape></item>
</selector>
