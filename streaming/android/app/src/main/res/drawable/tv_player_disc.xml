<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the disc centred and make keyboard focus visible without moving its glyph. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#73101014" />
            <stroke android:width="2dp" android:color="@color/tv_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#73101014" />
            <stroke android:width="1dp" android:color="@color/tv_hairline" />
        </shape>
    </item>
</selector>
