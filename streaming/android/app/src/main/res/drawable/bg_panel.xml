<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the shared player's options panel: a floating glass sheet. The video under it is a surface the view tree
     can't blur, so the glass is dense enough to read on its own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/tv_material_player" />
    <stroke android:width="1dp" android:color="@color/tv_hairline" />
    <corners android:radius="@dimen/tv_radius_sheet" />
</shape>
