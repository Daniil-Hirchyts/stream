<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="oval"><solid android:color="@color/tv_glass_focus_fill" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="@color/tv_glass_pressed" /></shape></item>
    <item android:state_activated="true"><shape android:shape="oval"><solid android:color="@color/tv_glass_selected" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="@color/tv_glass_low" /></shape></item>
</selector>
