<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Daniil TV palette: near-black canvas, translucent platters and white focus, after tvOS. -->
    <color name="tv_background">#FF0A0A0D</color>
    <color name="tv_surface">#FF1C1C1E</color>
    <color name="tv_hairline">#1FFFFFFF</color>
    <color name="tv_text">#FFF5F5F7</color>
    <color name="tv_text_secondary">#A6EBEBF5</color>
    <!-- 60%, not tvOS's 30%: at least 4.5:1 on the canvas for small text read from across a room. -->
    <color name="tv_text_tertiary">#99EBEBF5</color>
    <!-- Secondary text over artwork (spotlight and details facts): brighter, as the scrim there can be light. -->
    <color name="tv_text_on_artwork">#DBEBEBF5</color>
    <color name="tv_on_focus">#FF111113</color>
    <color name="tv_on_focus_secondary">#99111113</color>
    <color name="tv_focus">#FFFFFFFF</color>
    <color name="tv_warning">#FFFFD60A</color>
    <!-- tvOS materials: translucent platters at rest, a white platter for focus. -->
    <color name="tv_platter">#24FFFFFF</color>
    <color name="tv_platter_low">#12FFFFFF</color>
    <color name="tv_platter_selected">#3DFFFFFF</color>
    <color name="tv_chip_selected">#E0FFFFFF</color>
    <color name="tv_focus_pressed">#D9FFFFFF</color>
    <color name="tv_material_thin">#52222227</color>
    <color name="tv_material">#E6202024</color>
    <!-- Alerts: translucent glass over a blurred, slightly darkened copy of the screen. -->
    <color name="tv_material_dialog">#A62A2A30</color>
    <color name="tv_alert_tint">#59000000</color>
    <!-- Behind the player's error alert: the last frame, darkened. A video surface can't be blurred from the view tree. -->
    <color name="tv_player_error_backdrop">#C7000000</color>
    <color name="tv_material_player">#E01E1E22</color>

    <!-- The shared player takes the same neutral palette in this app only; Daniil Cast keeps its own. -->
    <color name="ink" tools:ignore="UnusedResources">#FF000000</color>
    <color name="surface" tools:ignore="UnusedResources">#FF1C1C1E</color>
    <color name="surface_raised" tools:ignore="UnusedResources">#FF2C2C2E</color>
    <color name="line" tools:ignore="UnusedResources">#1FFFFFFF</color>
    <color name="text_primary" tools:ignore="UnusedResources">#FFF5F5F7</color>
    <color name="text_secondary" tools:ignore="UnusedResources">#A6EBEBF5</color>
    <color name="text_tertiary" tools:ignore="UnusedResources">#99EBEBF5</color>
    <color name="accent" tools:ignore="UnusedResources">#FFFFFFFF</color>
    <color name="accent_soft" tools:ignore="UnusedResources">#33FFFFFF</color>
</resources>
