<resources>
    <string name="app_name">Stream</string>
    <string name="player_audio_subtitles">Audio and subtitles</string>
    <style name="TvTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/tv_background</item>
        <item name="android:colorAccent">@color/tv_focus</item>
        <item name="android:colorControlActivated">@color/tv_focus</item>
        <item name="android:textColorHighlight">#66FFFFFF</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:alertDialogTheme">@style/TvDialog</item>
    </style>
    <style name="Spinner">
        <item name="android:indeterminateDrawable">@drawable/tv_loading_indicator</item>
        <item name="android:indeterminateTint">@color/tv_text</item>
        <item name="android:indeterminateTintMode">src_in</item>
    </style>
    <!-- Translucent rounded glass sheets. -->
    <style name="TvDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/tv_dialog</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:colorBackground">@color/tv_surface</item>
        <item name="android:colorAccent">@color/tv_focus</item>
        <item name="android:colorControlActivated">@color/tv_focus</item>
        <item name="android:colorControlNormal">@color/tv_text_secondary</item>
        <item name="android:textColorPrimary">@color/tv_text</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/tv_text</item>
        <item name="android:textColorHint">@color/tv_text_tertiary</item>
        <item name="android:windowTitleStyle">@style/TvDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/TvDialogSecondaryButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/TvDialogPrimaryButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/TvDialogSecondaryButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/TvDialogSecondaryButton</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TvDialogTitle" parent="android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TvDialogSecondaryButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:background">@drawable/tv_dialog_button</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="TvDialogPrimaryButton" parent="TvDialogSecondaryButton">
        <item name="android:background">@drawable/tv_dialog_primary</item>
        <item name="android:textColor">@color/tv_on_focus</item>
    </style>
</resources>
