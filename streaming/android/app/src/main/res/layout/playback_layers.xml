<?xml version="1.0" encoding="utf-8"?>
<!-- Stream's override of the shared player's layers (same IDs and view types; see android/playback). Layers, bottom to
     top: preparing state, buffering, playback overlay, subtitles, up next, error. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Preparing: opening, or another step the app names, until the first frame is ready. Not an error. -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/idle_inset"
        android:paddingEnd="@dimen/idle_inset"
        android:visibility="gone">

        <ProgressBar
            style="@style/Spinner"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/loading_step"
            style="@style/Text.Overline"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/loading_title"
            style="@style/Text.Title"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2" />

        <TextView
            android:id="@+id/loading_message"
            style="@style/Text.Body"
            android:layout_width="560dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        style="@style/Spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Playback overlay, after tvOS: the title at the top with the two things a viewer reaches for (audio and
         subtitles, and leaving) beside it; the timeline at the bottom with one centred transport row between the
         times. Every control works by remote, pointer and touch; the remote's own keys stay the quickest way. -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/safe_horizontal"
            android:layout_marginTop="@dimen/safe_vertical"
            android:layout_marginEnd="@dimen/safe_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/controls_title"
                    style="@style/Text.Title"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/controls_details"
                    style="@style/Text.Caption"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="@color/tv_text_on_artwork"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:id="@+id/control_options"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/tv_button_round"
                android:contentDescription="@string/player_audio_subtitles"
                android:padding="13dp"
                android:src="@drawable/ic_tv_subtitles"
                android:tint="@color/tv_on_glass" />

            <ImageView
                android:id="@+id/control_stop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/tv_button_round"
                android:contentDescription="@string/hint_close"
                android:padding="14dp"
                android:src="@drawable/ic_tv_close"
                android:tint="@color/tv_on_glass" />
        </LinearLayout>

        <ImageView
            android:id="@+id/center_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/tv_player_disc"
            android:contentDescription="@string/control_play"
            android:padding="22dp"
            android:src="@drawable/ic_play"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/seek_bubble"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/seek_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:tint="@color/tv_text" />

            <TextView
                android:id="@+id/seek_label"
                style="@style/Text.Title"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/safe_horizontal"
            android:layout_marginEnd="@dimen/safe_horizontal"
            android:layout_marginBottom="@dimen/safe_vertical"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/control_seek"
                android:max="1000"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progressDrawable="@drawable/progress"
                android:splitTrack="false"
                android:thumbTint="@color/tv_focus" />

            <!-- Elapsed and remaining at the ends; rewind, play/pause and forward between them. The play button keeps one
                 width for both labels, so nothing moves when it changes. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/elapsed"
                    style="@style/Text.Time"
                    android:layout_gravity="start|center_vertical"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/control_rewind"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/tv_button_round"
                        android:contentDescription="@string/control_rewind"
                        android:padding="13dp"
                        android:src="@drawable/ic_rewind"
                        android:tint="@color/tv_on_glass" />

                    <TextView
                        android:id="@+id/control_play"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/tv_button"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="128dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/control_play"
                        android:textColor="@color/tv_on_glass"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/control_forward"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/tv_button_round"
                        android:contentDescription="@string/control_forward"
                        android:padding="13dp"
                        android:src="@drawable/ic_forward"
                        android:tint="@color/tv_on_glass" />
                </LinearLayout>

                <TextView
                    android:id="@+id/remaining"
                    style="@style/Text.Time"
                    android:layout_gravity="end|center_vertical"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="@color/tv_text_on_artwork" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Subtitles sit above the overlay's scrim so it never dims them. Between cues, this view also shows a
         sample line while subtitle style changes. -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Up next: shown when an episode ends and the series has another. -->
    <LinearLayout
        android:id="@+id/up_next"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:background="@drawable/bg_card_soft"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            style="@style/Text.Overline"
            android:text="@string/up_next" />

        <TextView
            android:id="@+id/up_next_title"
            style="@style/Text.Title"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/up_next_detail"
            style="@style/Text.Caption"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/up_next_play" style="@style/Action" android:text="@string/hint_play_now" />
            <TextView android:id="@+id/up_next_cancel" style="@style/Action" android:text="@string/hint_cancel" />
        </LinearLayout>
    </LinearLayout>

    <!-- Error: only for problems the viewer has to act on. -->
    <FrameLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B1116"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="44dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/alert_circle"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_alert"
                android:tint="@color/danger" />

            <TextView
                android:id="@+id/error_title"
                style="@style/Text.Title"
                android:layout_marginTop="28dp" />

            <TextView
                android:id="@+id/error_message"
                style="@style/Text.Body"
                android:layout_marginTop="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:id="@+id/error_retry" style="@style/Action" android:text="@string/hint_retry" />
                <!-- Shown only when the app can offer another source. -->
                <TextView android:id="@+id/error_sources" style="@style/Action" android:text="@string/hint_sources"
                    android:visibility="gone" />
                <TextView android:id="@+id/error_close" style="@style/Action" android:text="@string/hint_close" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</merge>
