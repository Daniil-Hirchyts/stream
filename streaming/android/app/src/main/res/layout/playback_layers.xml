<?xml version="1.0" encoding="utf-8"?>
<!-- Stream's override of the shared player's layers (same IDs and view types; see android/playback). Layers, bottom to
     top: preparing state, buffering, playback overlay, subtitles, up next, error. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Preparing: opening, or another step the app names, until the first frame is ready. Not an error. -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/idle_inset"
        android:paddingEnd="@dimen/idle_inset"
        android:visibility="gone">

        <TextView
            android:id="@+id/loading_step"
            style="@style/Text.Overline" />

        <TextView
            android:id="@+id/loading_title"
            style="@style/Text.Title"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2" />

        <TextView
            android:id="@+id/loading_message"
            style="@style/Text.Body"
            android:layout_width="560dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:visibility="gone" />

        <ProgressBar
            style="@style/Spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        style="@style/Spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Playback overlay, after tvOS: the title at the top with the two things a viewer reaches for (audio and
         subtitles) beside it, and the timeline at the bottom. Every control works by remote, pointer
         and touch. -->
    <!-- Not clipping, so a focused button's growth is drawn whole. -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/safe_horizontal"
            android:layout_marginTop="@dimen/safe_vertical"
            android:layout_marginEnd="@dimen/safe_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The shared exit action becomes a minimal Back button beside the title. -->
            <ImageView
                android:id="@+id/control_stop"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:layout_gravity="top"
                android:background="@drawable/tv_utility_button"
                android:contentDescription="@string/hint_back"
                android:defaultFocusHighlightEnabled="false"
                android:padding="10dp"
                android:rotation="180"
                android:src="@drawable/ic_tv_chevron"
                android:tint="@color/tv_on_glass_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/controls_title"
                    style="@style/Text.Title"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/watching_info"
                    style="@style/Text.Caption"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="@color/tv_text_on_artwork"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/controls_details"
                    style="@style/Text.Caption"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="@color/tv_text_on_artwork"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- The time of day, shown with the overlay; Settings → Clock picks its format or turns it off. -->
            <TextClock
                android:id="@+id/player_clock"
                style="@style/Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:importantForAccessibility="no"
                android:shadowColor="#B3000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="@color/tv_text_on_artwork"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/control_options"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/tv_button_round"
                android:contentDescription="@string/player_audio_subtitles"
                android:padding="13dp"
                android:src="@drawable/ic_tv_subtitles"
                android:tint="@color/tv_on_glass" />

            <!-- Quality, speed and subtitle style; the button beside it holds the audio and subtitle choices. -->
            <ImageView
                android:id="@+id/control_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/tv_button_round"
                android:contentDescription="@string/player_settings"
                android:padding="13dp"
                android:src="@drawable/ic_tv_settings"
                android:tint="@color/tv_on_glass" />

        </LinearLayout>

        <ImageView
            android:id="@+id/center_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/tv_player_disc"
            android:contentDescription="@string/control_play"
            android:padding="22dp"
            android:src="@drawable/ic_play"
            android:visibility="gone" />



        <!-- The timeline, low on the screen, with the times under its ends. The remote plays and pauses (OK), skips
             (left and right) and opens the menu; a pointer clicks the centre glyph or drags the timeline. The
             transport buttons stay in the layout, hidden, because the shared player binds them. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/safe_horizontal"
            android:layout_marginEnd="@dimen/safe_horizontal"
            android:layout_marginBottom="22dp"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/control_seek"
                android:max="1000"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progressDrawable="@drawable/progress"
                android:splitTrack="false"
                android:thumbTint="@color/tv_focus" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:minHeight="28dp">

                <!-- Seek feedback lives beside the timeline times, leaving the picture clear. -->
                <!-- No box, and no taller than the times' row, so showing it moves nothing. -->
                <LinearLayout
                    android:id="@+id/seek_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/seek_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:tint="@color/tv_text" />

                    <TextView
                        android:id="@+id/seek_label"
                        style="@style/Text.Time"
                        android:layout_marginStart="8dp"
                        android:textSize="18sp"
                        android:shadowColor="#B3000000"
                        android:shadowDy="1"
                        android:shadowRadius="6" />
                </LinearLayout>

                <TextView
                    android:id="@+id/elapsed"
                    style="@style/Text.Time"
                    android:layout_gravity="start|center_vertical"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6" />

                <TextView
                    android:id="@+id/remaining"
                    style="@style/Text.Time"
                    android:layout_gravity="end|center_vertical"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textColor="@color/tv_text_on_artwork" />

                <ImageView
                    android:id="@+id/control_rewind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/control_rewind"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/control_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/control_forward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/control_forward"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Subtitles sit above the overlay's scrim so it never dims them. Between cues, this view also shows a
         sample line while subtitle style changes. -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Up next: shown when an episode ends and the series has another. -->
    <LinearLayout
        android:id="@+id/up_next"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:background="@drawable/bg_card_soft"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            style="@style/Text.Overline"
            android:text="@string/up_next" />

        <TextView
            android:id="@+id/up_next_title"
            style="@style/Text.Title"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/up_next_detail"
            style="@style/Text.Caption"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/up_next_play" style="@style/Action" android:text="@string/hint_play_now" />
            <TextView android:id="@+id/up_next_cancel" style="@style/Action" android:text="@string/hint_cancel" />
        </LinearLayout>
    </LinearLayout>

    <!-- Error: only for problems the viewer has to act on. A glass alert, as elsewhere in the app: the title and
         message centred, then full-width buttons, one above the other; OK presses the focused one. -->
    <FrameLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_player_error_backdrop"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tv_dialog"
            android:elevation="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="32dp"
            android:paddingEnd="30dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/error_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:textColor="@color/tv_text"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/tv_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/error_retry"
                style="@style/TvPlayerAlertButton"
                android:layout_marginTop="28dp"
                android:text="@string/hint_retry" />

            <!-- Shown only when the app can offer another source. -->
            <TextView
                android:id="@+id/error_sources"
                style="@style/TvPlayerAlertButton"
                android:text="@string/hint_sources"
                android:visibility="gone" />

            <!-- Close is the way out: set apart and outlined, as Tv.Alert.cancelButton draws it. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:background="@color/tv_hairline" />

            <TextView
                android:id="@+id/error_close"
                style="@style/TvPlayerAlertButton"
                android:layout_marginTop="16dp"
                android:background="@drawable/tv_dialog_cancel"
                android:text="@string/hint_close"
                android:textColor="@color/tv_on_glass_secondary" />
        </LinearLayout>
    </FrameLayout>
</merge>
