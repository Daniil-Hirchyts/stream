<?xml version="1.0" encoding="utf-8"?>
<!-- Stream's override of the shared player's top layers (same IDs and view types; see android/playback). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Retain the shared binding without a transient notification layer in Stream. -->
    <FrameLayout android:layout_width="0dp" android:layout_height="0dp"
        android:importantForAccessibility="noHideDescendants" android:visibility="gone">
        <TextView android:id="@+id/notice" android:layout_width="0dp" android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Options, opened by click/touch or the remote Menu shortcut. Back and Menu leave it; a pointer clicks the
         header's chevron or anywhere outside. -->
    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/tv_dialog"
        android:elevation="24dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <!-- The library reads the chevron and the title as separate views. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/menu_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:contentDescription="@string/hint_back"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/menu_title"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_marginStart="18dp"
                android:textSize="21sp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <tv.daniil.stream.ui.PopupScrollView
            android:id="@+id/menu_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fadingEdgeLength="32dp"
            android:focusable="false"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menu_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </tv.daniil.stream.ui.PopupScrollView>

        <!-- The shared player binds these; the remote's Back and Menu keys do their work here. -->
        <TextView android:id="@+id/menu_go_back" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" />
        <TextView android:id="@+id/menu_close" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</merge>
