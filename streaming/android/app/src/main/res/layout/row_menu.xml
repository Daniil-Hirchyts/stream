<?xml version="1.0" encoding="utf-8"?>
<!-- Stream's override of the shared player's menu row (same IDs and view types). The panel marks the focused row as
     selected; its label, value and mark follow, turning dark on the white platter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_option_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/row_label"
        style="@style/Text.Label"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:duplicateParentState="true"
        android:textColor="@color/option_label" />

    <TextView
        android:id="@+id/row_value"
        style="@style/Text.Caption"
        android:duplicateParentState="true"
        android:textColor="@color/tv_menu_value"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxWidth="170dp"
        android:maxLines="1"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:duplicateParentState="true"
        android:tint="@color/menu_icon"
        android:tintMode="src_in" />
</LinearLayout>
