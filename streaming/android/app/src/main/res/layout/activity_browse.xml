<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork and page content fill the screen; the translucent header floats above both. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_canvas">
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_canvas">
        <ImageView
            android:id="@+id/backdrop_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <View
            android:id="@+id/backdrop_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/tv_scrim" />
    </eightbitlab.com.blurview.BlurTarget>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/side_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.38"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingTop="76dp"
                android:paddingEnd="20dp"
                android:paddingBottom="36dp"
                android:visibility="gone">
                <!-- tvOS Settings: a large lit icon over the section's name, beside its rows. -->
                <ImageView
                    android:id="@+id/side_icon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/tv_panel_icon"
                    android:elevation="12dp"
                    android:importantForAccessibility="no"
                    android:padding="32dp"
                    android:tint="@color/tv_text" />
                <TextView
                    android:id="@+id/side_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/tv_text"
                    android:textSize="25sp" />
                <TextView
                    android:id="@+id/side_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="7"
                    android:maxWidth="300dp"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/page_rows"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="80dp"
                android:paddingBottom="40dp"
                android:scrollbars="none" />
        </LinearLayout>
        <TextView
            android:id="@+id/page_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp"
            android:paddingBottom="4dp"
            android:textColor="@color/tv_text"
            android:textSize="28sp"
            android:visibility="gone" />
        <!-- The floating tab bar (tvOS): one blurred capsule, search first, centred; it slides away while content scrolls. -->
        <FrameLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="18dp"
            android:paddingEnd="48dp"
            android:paddingBottom="10dp">
            <tv.daniil.stream.ui.GlassView
                android:id="@+id/top_bar_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/tv_tabs"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="6dp"
                android:padding="4dp">
                <LinearLayout
                    android:id="@+id/tab_cluster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:id="@+id/search_button"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/tv_tab"
                        android:contentDescription="Search">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tv_search"
                            android:tint="@color/tv_tab_text" />
                    </FrameLayout>
                    <LinearLayout
                        android:id="@+id/navigation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />
                </LinearLayout>
            </tv.daniil.stream.ui.GlassView>
            <tv.daniil.stream.ui.GlassView
                android:id="@+id/search_expanded"
                android:layout_width="640dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/tv_tabs"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="5dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tv_search"
                        android:tint="@color/tv_text_secondary" />
                    <TextView
                        android:id="@+id/search_query"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:contentDescription="Search"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Search films, series and imports"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="17sp" />
                    <FrameLayout
                        android:id="@+id/search_close"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/tv_button_round"
                        android:contentDescription="Close search">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tv_close"
                            android:tint="@color/tv_on_glass" />
                    </FrameLayout>
                </LinearLayout>
            </tv.daniil.stream.ui.GlassView>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
