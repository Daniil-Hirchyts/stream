<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork and page content fill the screen; the translucent header floats above both. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tv_canvas">
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blur_target"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_canvas">
        <ImageView
            android:id="@+id/backdrop_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <!-- The same artwork, blurred and fading in towards the bottom, where text, buttons and shelves sit. -->
        <ImageView
            android:id="@+id/backdrop_soft"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
        <View
            android:id="@+id/backdrop_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/tv_scrim" />
    </eightbitlab.com.blurview.BlurTarget>
    <!-- Not clipping: a parent that clips cuts each child at its own bounds, which would crop a focused control's
         growth (Back, the page tools). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/page_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="80dp"
            android:paddingBottom="40dp"
            android:scrollbars="none" />
        <View
            android:id="@+id/scroll_fade"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            android:alpha="0"
            android:background="@drawable/tv_scroll_fade"
            android:importantForAccessibility="no" />
        <!-- The floating tab bar (tvOS): one blurred capsule, search first, centred; it slides away while content scrolls. -->
        <FrameLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="18dp"
            android:paddingEnd="48dp"
            android:paddingBottom="10dp">
            <tv.daniil.stream.ui.GlassView
                android:id="@+id/top_bar_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/tv_tabs"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="6dp"
                android:padding="4dp">
                <LinearLayout
                    android:id="@+id/tab_cluster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:id="@+id/search_button"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/tv_tab"
                        android:contentDescription="Search">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tv_search"
                            android:tint="@color/tv_tab_text" />
                    </FrameLayout>
                    <LinearLayout
                        android:id="@+id/navigation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />
                </LinearLayout>
            </tv.daniil.stream.ui.GlassView>
            <tv.daniil.stream.ui.GlassView
                android:id="@+id/search_expanded"
                android:layout_width="640dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/tv_tabs"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="5dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tv_search"
                        android:tint="@color/tv_text_secondary" />
                    <TextView
                        android:id="@+id/search_query"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:contentDescription="Search"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Search films, series and imports"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="17sp" />
                    <FrameLayout
                        android:id="@+id/search_close"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/tv_button_round"
                        android:contentDescription="Close search">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tv_close"
                            android:tint="@color/tv_on_glass" />
                    </FrameLayout>
                </LinearLayout>
            </tv.daniil.stream.ui.GlassView>
        </FrameLayout>
        <!-- Shared navigation is outside scrolling content and the sliding tab bar. -->
        <FrameLayout
            android:id="@+id/page_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="22dp"
            android:layout_marginStart="48dp"
            android:background="@drawable/tv_utility_button"
            android:contentDescription="Back"
            android:elevation="8dp"
            android:visibility="gone">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_gravity="center" android:rotation="180"
                android:src="@drawable/ic_tv_chevron" android:tint="@color/tv_on_glass_secondary"
                android:duplicateParentState="true" android:importantForAccessibility="no" />
        </FrameLayout>
        <!-- The clock sits beside the page tools, at the screen's top right corner. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|right"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="48dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/home_tools"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <FrameLayout android:id="@+id/home_browse" android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/tv_utility_button" android:contentDescription="Browse catalogues">
                <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center"
                    android:src="@drawable/ic_tv_list" android:tint="@color/tv_on_glass_secondary"
                    android:duplicateParentState="true" android:importantForAccessibility="no" />
            </FrameLayout>
            <FrameLayout android:id="@+id/home_refresh" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginStart="8dp" android:background="@drawable/tv_utility_button" android:contentDescription="Refresh">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
                    android:src="@drawable/ic_tv_refresh" android:tint="@color/tv_on_glass_secondary"
                    android:duplicateParentState="true" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
        <TextClock
            android:id="@+id/clock"
            style="@style/Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:importantForAccessibility="no"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@color/tv_text_secondary"
            android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
