<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B1116" android:orientation="horizontal" android:padding="24dp">
    <LinearLayout android:id="@+id/navigation" android:layout_width="132dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="16dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/page_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F4F7F6" android:textSize="30sp" android:paddingBottom="12dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/page_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="24dp" />
    </LinearLayout>
</LinearLayout>
