# Boost from the pinned source release, headers only: the parts libtorrent needs (Asio, System, and others)
# don't require compiled libraries since Boost 1.69. DTV_BOOST_INCLUDE is set by the top-level CMakeLists.txt.
set(Boost_VERSION 1.90.0)
set(Boost_VERSION_STRING 1.90.0)
set(Boost_MAJOR_VERSION 1)
set(Boost_MINOR_VERSION 90)
set(Boost_SUBMINOR_VERSION 0)
set(Boost_INCLUDE_DIRS "${DTV_BOOST_INCLUDE}")
set(Boost_FOUND TRUE)
if(NOT TARGET Boost::headers)
	add_library(Boost::headers INTERFACE IMPORTED)
	set_target_properties(Boost::headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${DTV_BOOST_INCLUDE}")
endif()
if(NOT TARGET Boost::boost)
	add_library(Boost::boost ALIAS Boost::headers)
endif()
