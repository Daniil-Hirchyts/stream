<?xml version="1.0" encoding="utf-8"?>
<!-- Layers, bottom to top: video, idle and preparing states, playback overlay, subtitles, up next, error,
     pairing code, notice, options menu. -->
<FrameLayout android:id="@+id/player_root" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:show_buffering="never"
        app:shutter_background_color="@android:color/black"
        app:use_controller="false" />

    <!-- Idle: waiting for a video from Chrome. -->
    <FrameLayout
        android:id="@+id/idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_idle"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/idle_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/idle_inset"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/mark" />

                <TextView
                    style="@style/Text.Display"
                    android:layout_marginTop="36dp"
                    android:text="@string/idle_title" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="vertical">

                    <LinearLayout style="@style/StepRow">
                        <TextView style="@style/StepNumber" android:text="1" />
                        <TextView style="@style/StepLabel" android:text="@string/idle_step_1" />
                    </LinearLayout>

                    <LinearLayout style="@style/StepRow">
                        <TextView style="@style/StepNumber" android:text="2" />
                        <TextView style="@style/StepLabel" android:text="@string/idle_step_2" />
                    </LinearLayout>

                    <LinearLayout style="@style/StepRow">
                        <TextView style="@style/StepNumber" android:text="3" />
                        <TextView style="@style/StepLabel" android:text="@string/idle_step_3" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/idle_inset"
                android:layout_marginBottom="@dimen/safe_vertical"
                android:id="@+id/idle_settings"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/KeyCap.Icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_menu" />

                <TextView style="@style/KeyHint" android:text="@string/hint_settings" />

                <TextView
                    android:id="@+id/idle_device"
                    style="@style/Text.Caption"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Preparing: opening, or converting on the Mac, until the first frame is ready. Not an error. -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/idle_inset"
        android:paddingEnd="@dimen/idle_inset"
        android:visibility="gone">

        <ProgressBar
            style="@style/Spinner"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/loading_step"
            style="@style/Text.Overline"
            android:layout_marginTop="32dp"
            android:text="@string/step_opening" />

        <TextView
            android:id="@+id/loading_title"
            style="@style/Text.Title"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2" />

        <TextView
            android:id="@+id/loading_message"
            style="@style/Text.Body"
            android:layout_width="560dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        style="@style/Spinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Playback overlay. -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/safe_horizontal"
            android:layout_marginTop="@dimen/safe_vertical"
            android:layout_marginEnd="@dimen/safe_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Overline"
                android:text="@string/now_playing" />

            <TextView
                android:id="@+id/controls_title"
                style="@style/Text.Title"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/controls_details"
                style="@style/Text.Caption"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/center_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/disc"
            android:contentDescription="@string/control_play"
            android:padding="28dp"
            android:src="@drawable/ic_play"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/seek_bubble"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="26dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/seek_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:tint="@color/accent" />

            <TextView
                android:id="@+id/seek_label"
                style="@style/Text.Title"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/safe_horizontal"
            android:layout_marginEnd="@dimen/safe_horizontal"
            android:layout_marginBottom="@dimen/safe_vertical"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="@string/control_seek"
                android:thumbTint="@color/accent"
                android:splitTrack="false"
                android:max="1000"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progressDrawable="@drawable/progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/elapsed"
                    style="@style/Text.Time" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/remaining"
                    style="@style/Text.Time"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:id="@+id/control_rewind" style="@style/Action" android:text="@string/control_rewind" />
                <TextView android:id="@+id/control_play" style="@style/Action" android:text="@string/control_play" />
                <TextView android:id="@+id/control_forward" style="@style/Action" android:text="@string/control_forward" />
                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView android:id="@+id/control_options" style="@style/Action" android:text="@string/hint_options" />
                <TextView android:id="@+id/control_stop" style="@style/Action" android:text="@string/control_stop" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Subtitles sit above the overlay's scrim so it never dims them. Between cues, this view also shows a
         sample line while subtitle style changes. -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Up next: shown when an episode ends and the series has another. -->
    <LinearLayout
        android:id="@+id/up_next"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/safe_horizontal"
        android:layout_marginBottom="@dimen/safe_vertical"
        android:background="@drawable/bg_card_soft"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            style="@style/Text.Overline"
            android:text="@string/up_next" />

        <TextView
            android:id="@+id/up_next_title"
            style="@style/Text.Title"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/up_next_detail"
            style="@style/Text.Caption"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/up_next_play" style="@style/Action" android:text="@string/hint_play_now" />
            <TextView android:id="@+id/up_next_cancel" style="@style/Action" android:text="@string/hint_cancel" />
        </LinearLayout>
    </LinearLayout>

    <!-- Error: only for problems the viewer has to act on. -->
    <FrameLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B1116"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="44dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/alert_circle"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:src="@drawable/ic_alert"
                android:tint="@color/danger" />

            <TextView
                android:id="@+id/error_title"
                style="@style/Text.Title"
                android:layout_marginTop="28dp" />

            <TextView
                android:id="@+id/error_message"
                style="@style/Text.Body"
                android:layout_marginTop="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:id="@+id/error_retry" style="@style/Action" android:text="@string/hint_retry" />
                <TextView android:id="@+id/error_close" style="@style/Action" android:text="@string/hint_close" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Pairing code, shown on the idle screen until a Mac pairs, and on request over anything else. -->
    <LinearLayout
        android:id="@+id/pairing"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/idle_inset"
        android:background="@drawable/bg_card_soft"
        android:orientation="vertical"
        android:padding="36dp"
        android:visibility="gone">

        <TextView
            style="@style/Text.Overline"
            android:text="@string/pairing_overline" />

        <TextView
            android:id="@+id/pairing_code"
            style="@style/Text.PairingCode"
            android:layout_marginTop="20dp" />

        <TextView
            style="@style/Text.Body"
            android:layout_marginTop="20dp"
            android:text="@string/pairing_body"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Short notices, such as "Paired with Chrome on MacBook". -->
    <TextView
        android:id="@+id/notice"
        style="@style/Text.Label"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/safe_vertical"
        android:background="@drawable/pill"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <!-- Options, opened with the remote's Menu button. -->
    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="@dimen/panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="@dimen/safe_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/menu_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:contentDescription="@string/hint_back"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/menu_title"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/menu_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:fadingEdgeLength="32dp"
            android:focusable="false"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menu_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/menu_go_back" style="@style/Action" android:text="@string/hint_back" />
            <TextView android:id="@+id/menu_close" style="@style/Action" android:text="@string/hint_close" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
