<?xml version="1.0" encoding="utf-8"?>
<!-- The type scale, keycaps and actions come from the shared playback library. -->
<resources>
    <style name="Theme.DaniilCast" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Six digits read from across the room; tabular figures keep the groups even. -->
    <style name="Text.PairingCode">
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@drawable/bg_code</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">44sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="StepNumber" parent="Text">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/step_number</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="StepLabel" parent="Text.Label">
        <item name="android:layout_marginStart">14dp</item>
    </style>
    <style name="StepRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
