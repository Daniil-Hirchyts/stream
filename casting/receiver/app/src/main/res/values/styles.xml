<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DaniilCast" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Type scale. Sizes are for a 10-foot screen; 1 sp is 2 px at the stick's 320 dpi. -->
    <style name="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Text.Display">
        <item name="android:textSize">42sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Text.Title">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">17sp</item>
    </style>
    <style name="Text.Value">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Overline">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Text.Time">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Code">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Six digits read from across the room; tabular figures keep the groups even. -->
    <style name="Text.PairingCode">
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@drawable/bg_code</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">44sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Remote buttons drawn as small keycaps next to what they do. -->
    <style name="KeyCap" parent="Text">
        <item name="android:layout_height">28dp</item>
        <item name="android:minWidth">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/keycap</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="KeyCap.Icon">
        <item name="android:layout_width">34dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
    <style name="KeyHint" parent="Text.Caption">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">28dp</item>
    </style>

    <style name="StepNumber" parent="Text">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/step_number</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="StepLabel" parent="Text.Label">
        <item name="android:layout_marginStart">14dp</item>
    </style>
    <style name="StepRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Spinner">
        <item name="android:indeterminateTint">@color/accent</item>
        <item name="android:indeterminateTintMode">src_in</item>
    </style>
    <!-- Full pointer/touch targets; remote shortcuts work alongside these controls. -->
    <style name="Action" parent="Text.Label">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/keycap</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>
</resources>
