{
  "manifest_version": 3,
  "name": "Daniil Cast",
  "version": "0.3.1",
  "description": "Send videos with their episodes, voice-overs and subtitles from Chrome to your TV.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "webRequest",
    "nativeMessaging",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Daniil Cast",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
