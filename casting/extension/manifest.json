{
  "manifest_version": 3,
  "name": "Daniil Cast",
  "version": "0.1.1",
  "description": "Send a video stream from Chrome directly to your Fire TV over your trusted ADB connection.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "nativeMessaging",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cast video to Fire TV",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
