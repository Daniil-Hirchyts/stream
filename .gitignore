.DS_Store
.env
.env.*
*.log
# Device snapshots and test captures are private local evidence, not app sources.
backups/
# Machine-local Android and build output; component ignores cover their own caches.
**/local.properties
sounds/build/
# Native and Gradle build output and simulator caches stay local.
native/build/
# Cargo output of the Rust engine and evaluation crates.
native/core/target/
native/eval/*/target/
android/.gradle/
android/**/build/
simulator/.cache/
local.properties
android/**/.cxx*/

# Editor and coding-agent workspaces are per machine.
.claude/
.vscode/
.idea/

# Kotlin compiler session files and Python interpreter caches are machine local.
android/.kotlin/
__pycache__/
*.pyc

# Release signing keys stay outside version control
*.jks
*.keystore
